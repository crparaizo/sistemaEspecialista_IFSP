# ============================================================
# Configurações do Sistema Triador de OS
# ============================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário


# ============================================================
# CONFIGURAÇÕES DA LLM (Camada Conexionista)
# ============================================================

# Provedor de LLM: "ollama" (local) ou "api" (externa - futura)
LLM_PROVIDER=ollama

# Modelo LLM a ser utilizado
# Exemplos para Ollama: qwen2.5:7b, llama3.1:8b, mistral:7b, phi3:medium
LLM_MODEL=qwen2.5:7b

# URL base do servidor Ollama
LLM_BASE_URL=http://localhost:11434

# Timeout para chamadas à LLM (segundos)
LLM_TIMEOUT=60

# Temperatura (0.0 = determinístico, 1.0 = criativo)
LLM_TEMPERATURE=0.1


# ============================================================
# CONFIGURAÇÕES DE API EXTERNA (Futura Implementação)
# ============================================================

# Chave de API (quando usar provedor externo)
# API_KEY=sua-chave-aqui

# Endpoint da API externa
# API_ENDPOINT=https://api.example.com/v1


# ============================================================
# CONFIGURAÇÕES DO SISTEMA ESPECIALISTA (Camada Simbólica)
# ============================================================

# Modo do sistema especialista: "strict" ou "flexible"
EXPERT_MODE=strict

# Habilitar regras de fallback quando nenhuma regra específica se aplica
ENABLE_FALLBACK_RULES=true


# ============================================================
# CONFIGURAÇÕES DE LOGGING
# ============================================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Formato de log: "json" ou "text"
LOG_FORMAT=json

# Caminho para arquivo de log (deixe vazio para apenas console)
# LOG_FILE=logs/triador.log


# ============================================================
# CONFIGURAÇÕES DA API REST
# ============================================================

# Host da API
API_HOST=0.0.0.0

# Porta da API
API_PORT=8000

# Hot-reload no desenvolvimento
API_RELOAD=false


# ============================================================
# CONFIGURAÇÕES DE AVALIAÇÃO
# ============================================================

# Diretório para salvar resultados de avaliação
EVALUATION_OUTPUT_DIR=data/evaluation_results


# ============================================================
# CONFIGURAÇÕES GERAIS
# ============================================================

# Modo debug
DEBUG=false

# Número máximo de tentativas para chamadas que falharem
MAX_RETRIES=3
